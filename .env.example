# Public by design. Row Level Security is what keeps the database safe.
# Leave both empty and Kilobyte stays a static site: local cards, local uploads,
# versus-bots Cinder Field, and on-device recommendations.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Do not put GEMINI_API_KEY or the service role key here.
# GEMINI_API_KEY belongs on the Supabase edge function named "studio".
